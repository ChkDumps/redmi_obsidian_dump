					drive-strength = <0x01>;
				};
			};

			camera_pins_cam0_mclk_6ma {
				phandle = <0x0d>;

				pins_cmd_dat {
					pinmux = <0x8001>;
					drive-strength = <0x02>;
				};
			};

			camera_pins_cam0_mclk_8ma {
				phandle = <0x0e>;

				pins_cmd_dat {
					pinmux = <0x8001>;
					drive-strength = <0x03>;
				};
			};

			camera_pins_cam1_mclk_off {
				phandle = <0x0f>;

				pins_cmd_dat {
					pinmux = <0x7e00>;
					drive-strength = <0x01>;
				};
			};

			camera_pins_cam1_mclk_2ma {
				phandle = <0x10>;

				pins_cmd_dat {
					pinmux = <0x7e01>;
					drive-strength = <0x00>;
				};
			};

			camera_pins_cam1_mclk_4ma {
				phandle = <0x11>;

				pins_cmd_dat {
					pinmux = <0x7e01>;
					drive-strength = <0x01>;
				};
			};

			camera_pins_cam1_mclk_6ma {
				phandle = <0x12>;

				pins_cmd_dat {
					pinmux = <0x7e01>;
					drive-strength = <0x02>;
				};
			};

			camera_pins_cam1_mclk_8ma {
				phandle = <0x13>;

				pins_cmd_dat {
					pinmux = <0x7e01>;
					drive-strength = <0x03>;
				};
			};

			camera_pins_cam2_mclk_off {
				phandle = <0x14>;

				pins_cmd_dat {
					pinmux = <0x8100>;
					drive-strength = <0x01>;
				};
			};

			camera_pins_cam2_mclk_2ma {
				phandle = <0x15>;

				pins_cmd_dat {
					pinmux = <0x8101>;
					drive-strength = <0x00>;
				};
			};

			camera_pins_cam2_mclk_4ma {
				phandle = <0x16>;

				pins_cmd_dat {
					pinmux = <0x8101>;
					drive-strength = <0x01>;
				};
			};

			camera_pins_cam2_mclk_6ma {
				phandle = <0x17>;

				pins_cmd_dat {
					pinmux = <0x8101>;
					drive-strength = <0x02>;
				};
			};

			camera_pins_cam2_mclk_8ma {
				phandle = <0x18>;

				pins_cmd_dat {
					pinmux = <0x8101>;
					drive-strength = <0x03>;
				};
			};

			camera_pins_cam3_mclk_off {
				phandle = <0x19>;

				pins_cmd_dat {
					pinmux = <0x7f00>;
					drive-strength = <0x01>;
				};
			};

			camera_pins_cam3_mclk_2ma {
				phandle = <0x1a>;

				pins_cmd_dat {
					pinmux = <0x7f01>;
					drive-strength = <0x00>;
				};
			};

			camera_pins_cam3_mclk_4ma {
				phandle = <0x1b>;

				pins_cmd_dat {
					pinmux = <0x7f01>;
					drive-strength = <0x01>;
				};
			};

			camera_pins_cam3_mclk_6ma {
				phandle = <0x1c>;

				pins_cmd_dat {
					pinmux = <0x7f01>;
					drive-strength = <0x02>;
				};
			};

			camera_pins_cam3_mclk_8ma {
				phandle = <0x1d>;

				pins_cmd_dat {
					pinmux = <0x7f01>;
					drive-strength = <0x03>;
				};
			};

			camdefault {
				phandle = <0x01>;
			};

			cam0@iocam0 {
				phandle = <0x1e>;

				pins_cmd_dat {
					pinmux = <0x9f00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			cam0@iocam1 {
				phandle = <0x1f>;

				pins_cmd_dat {
					pinmux = <0x9f00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			cam1@iocam0 {
				phandle = <0x20>;

				pins_cmd_dat {
					pinmux = <0x9f00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			cam1@iocam1 {
				phandle = <0x21>;

				pins_cmd_dat {
					pinmux = <0x9f00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			cam2@iocam0 {
				phandle = <0x22>;

				pins_cmd_dat {
					pinmux = <0x9f00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			cam2@iocam1 {
				phandle = <0x23>;

				pins_cmd_dat {
					pinmux = <0x9f00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			cam3@iocam0 {
				phandle = <0x24>;

				pins_cmd_dat {
					pinmux = <0x9f00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			cam3@iocam1 {
				phandle = <0x25>;

				pins_cmd_dat {
					pinmux = <0x9f00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			cam0@vcamaf0 {
				phandle = <0x26>;

				pins_cmd_dat {
					pinmux = <0x1300>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			cam0@vcamaf1 {
				phandle = <0x27>;

				pins_cmd_dat {
					pinmux = <0x1300>;
					slew-rate = <0x01>;
					output-high;
				};
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "default", "cam0_rst0", "cam0_rst1", "cam1_rst0", "cam1_rst1", "cam2_rst0", "cam2_rst1", "cam3_rst0", "cam3_rst1", "cam0_mclk_off", "cam0_mclk_2mA", "cam0_mclk_4mA", "cam0_mclk_6mA", "cam0_mclk_8mA", "cam1_mclk_off", "cam1_mclk_2mA", "cam1_mclk_4mA", "cam1_mclk_6mA", "cam1_mclk_8mA", "cam2_mclk_off", "cam2_mclk_2mA", "cam2_mclk_4mA", "cam2_mclk_6mA", "cam2_mclk_8mA", "cam3_mclk_off", "cam3_mclk_2mA", "cam3_mclk_4mA", "cam3_mclk_6mA", "cam3_mclk_8mA", "cam0_ldo_vcamio_0", "cam0_ldo_vcamio_1", "cam1_ldo_vcamio_0", "cam1_ldo_vcamio_1", "cam2_ldo_vcamio_0", "cam2_ldo_vcamio_1", "cam3_ldo_vcamio_0", "cam3_ldo_vcamio_1", "cam0_ldo_vcamafvdd_0", "cam0_ldo_vcamafvdd_1";
			pinctrl-0 = <0x01>;
			pinctrl-1 = <0x02>;
			pinctrl-2 = <0x03>;
			pinctrl-3 = <0x04>;
			pinctrl-4 = <0x05>;
			pinctrl-5 = <0x06>;
			pinctrl-6 = <0x07>;
			pinctrl-7 = <0x08>;
			pinctrl-8 = <0x09>;
			pinctrl-9 = <0x0a>;
			pinctrl-10 = <0x0b>;
			pinctrl-11 = <0x0c>;
			pinctrl-12 = <0x0d>;
			pinctrl-13 = <0x0e>;
			pinctrl-14 = <0x0f>;
			pinctrl-15 = <0x10>;
			pinctrl-16 = <0x11>;
			pinctrl-17 = <0x12>;
			pinctrl-18 = <0x13>;
			pinctrl-19 = <0x14>;
			pinctrl-20 = <0x15>;
			pinctrl-21 = <0x16>;
			pinctrl-22 = <0x17>;
			pinctrl-23 = <0x18>;
			pinctrl-24 = <0x19>;
			pinctrl-25 = <0x1a>;
			pinctrl-26 = <0x1b>;
			pinctrl-27 = <0x1c>;
			pinctrl-28 = <0x1d>;
			pinctrl-29 = <0x1e>;
			pinctrl-30 = <0x1f>;
			pinctrl-31 = <0x20>;
			pinctrl-32 = <0x21>;
			pinctrl-33 = <0x22>;
			pinctrl-34 = <0x23>;
			pinctrl-35 = <0x24>;
			pinctrl-36 = <0x25>;
			pinctrl-37 = <0x26>;
			pinctrl-38 = <0x27>;
			cam0_pin_mclk = "mclk";
			cam0_pin_rst = "gpio";
			cam0_pin_vcama = "smartldo";
			cam0_pin_vcamio = "gpio";
			cam0_pin_vcamd = "smartldo";
			cam0_pin_vcamaf = "gpio";
			cam1_pin_mclk = "mclk";
			cam1_pin_rst = "gpio";
			cam1_pin_vcama = "smartldo";
			cam1_pin_vcamio = "gpio";
			cam1_pin_vcamd = "smartldo";
			cam2_pin_mclk = "mclk";
			cam2_pin_rst = "gpio";
			cam2_pin_vcama = "smartldo";
			cam2_pin_vcamio = "gpio";
			cam2_pin_vcamd = "smartldo";
			cam3_pin_mclk = "mclk";
			cam3_pin_rst = "gpio";
			cam3_pin_vcama = "smartldo";
			cam3_pin_vcamio = "gpio";
			cam3_pin_vcamd = "smartldo";
			cam0_enable_sensor = "s5khp3_samsung_main_mipi_raw s5khp3_sunny_main_mipi_raw";
			cam1_enable_sensor = "ov32d40_ofilm_front_mipi_raw ov32d40_truly_front_mipi_raw";
			cam2_enable_sensor = "gc08a8_aac_ultra_mipi_raw gc08a8_sunny_ultra_mipi_raw";
			cam3_enable_sensor = "sc202cs_aac_macro_mipi_raw sc202cs_truly_macro_mipi_raw";
			status = "okay";
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0xf4240>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			camera-eeprom0@50 {
				compatible = "mediatek,camera_eeprom";
				reg = <0x50>;
				status = "okay";
				phandle = <0x51>;
			};

			camera_main@1a {
				compatible = "mediatek,camera_main";
				#thermal-sensor-cells = <0x00>;
				reg = <0x1a>;
				status = "okay";
				phandle = <0x28>;
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			camera-eeprom1@51 {
				compatible = "mediatek,camera_eeprom";
				reg = <0x51>;
				status = "okay";
				phandle = <0x52>;
			};

			camera_sub@20 {
				compatible = "mediatek,camera_sub";
				#thermal-sensor-cells = <0x00>;
				reg = <0x20>;
				status = "okay";
				phandle = <0x29>;
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			camera-eeprom3@53 {
				compatible = "mediatek,camera_eeprom";
				reg = <0x53>;
				status = "okay";
				phandle = <0x53>;
			};

			camera_sub_two@78 {
				compatible = "mediatek,camera_sub_two";
				#thermal-sensor-cells = <0x00>;
				reg = <0x78>;
				status = "okay";
				phandle = <0x54>;
			};

			camera-eeprom2@52 {
				compatible = "mediatek,camera_eeprom";
				reg = <0x52>;
				status = "okay";
				phandle = <0x55>;
			};

			camera_main_two@6c {
				compatible = "mediatek,camera_main_two";
				#thermal-sensor-cells = <0x00>;
				reg = <0x6c>;
				status = "okay";
				phandle = <0x2a>;
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";

			smart_ldo@28 {
				compatible = "mediatek,camera_smart_ldo";
				reg = <0x28>;
				status = "okay";
				phandle = <0x56>;
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {

			camera_main {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <0x28>;
				phandle = <0x57>;
			};

			camera_sub {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <0x29>;
				phandle = <0x58>;
			};

			camera_main_two {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <0x2a>;
				phandle = <0x59>;
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {

			sia81xx_gpio_R {
				phandle = <0x2b>;

				pins_cmd_dat {
					pinmux = <0x4300>;
					slew-rate = <0x01>;
					bias-disable;
				};
			};
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {

			si_pa_L {
				compatible = "si,sia81xx";
				si,si_pa_type = "sia8152x";
				si,si_pa_disable_pin = <0x01>;
				channel_num = <0x00>;
				phandle = <0x2c>;
			};

			si_pa_R {
				compatible = "si,sia81xx";
				si,si_pa_type = "sia81x9";
				si,si_pa_reset = <0xffffffff 0x43 0x00>;
				pinctrl-names = "si_pa_gpio";
				pinctrl-0 = <0x2b>;
				si,si_pa_disable_pin = <0x00>;
				channel_num = <0x01>;
				phandle = <0x2d>;
			};
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {
			si,sia81xx-max-num = <0x02>;
			si,sia81xx-aux-devs = <0x2c 0x2d>;
			si,sia81xx-aux-devs-prefix = "SpkrLeft", "SpkrRight";
		};
	};

	fragment@10 {
		target = <0xffffffff>;

		__overlay__ {
			clock-frequency = <0x61a80>;
			mediatek,use-open-drain;

			sipa_i2c_L@57 {
				compatible = "si,sia81xx-i2c";
				reg = <0x57>;
				si,sipa-dev = <0x2c>;
				si,sipa-addr_offset = <0x02>;
				status = "okay";
				phandle = <0x5a>;
			};

			sipa_i2c_R@28 {
				compatible = "si,sia81xx-i2c";
				reg = <0x28>;
				si,sipa-dev = <0x2d>;
				status = "okay";
				phandle = <0x5b>;
			};

			aw87xxx_pa_58@58 {
				compatible = "awinic,aw87xxx_pa";
				reg = <0x58>;
				reset-gpio = <0xffffffff 0x43 0x00>;
				dev_index = <0x01>;
				status = "okay";
			};

			aw87xxx_pa_59@59 {
				compatible = "awinic,aw87xxx_pa";
				reg = <0x59>;
				dev_index = <0x00>;
				status = "okay";
			};
		};
	};

	fragment@11 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;

			subpmic_core@61 {
				compatible = "southchip,subpmic_core";
				reg = <0x61>;
				status = "okay";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x04 0x00>;
				intr-gpio = <0xffffffff 0x04 0x00>;
				charger_name = "primary_chg";
				interrupt-controller;
				#interrupt-cells = <0x01>;

				subpmic_chg {
					compatible = "southchip,subpmic_chg";
					interrupts = <0x06 0x00 0x03 0x02>;
					interrupt-names = "Hourse Keeping", "Buck Charger", "DPDM", "LED";
					sc,vsys-limit = <0xdac>;
					sc,batsnc-enable = <0x01>;
					sc,vbat = <0x1162>;
					sc,charge-curr = <0x1f4>;
					sc,iindpm-disable = <0x00>;
					sc,input-curr-limit = <0x1f4>;
					sc,ico-enable = <0x00>;
					sc,iindpm-ico = <0x64>;
					sc,precharge-volt = <0x01>;
					sc,precharge-curr = <0x1f4>;
					sc,term-en = <0x01>;
					sc,term-curr = <0x1f4>;
					sc,rechg-dis = <0x00>;
					sc,rechg-dg = <0x00>;
					sc,rechg-volt = <0x00>;
					sc,boost-voltage = <0x1388>;
					sc,boost-max-current = <0x5dc>;
					sc,conv-ocp-dis = <0x00>;
					sc,tsbat-jeita-dis = <0x01>;
					sc,ibat-ocp-dis = <0x00>;
					sc,vpmid-ovp-otg-dis = <0x00>;
					sc,vbat-ovp-buck-dis = <0x00>;
					sc,ibat-ocp = <0x01>;
					status = "okay";
				};

				subpmic_ufcs {
					compatible = "southchip,subpmic_ufcs";
					interrupts = <0x05>;
					interrupt-names = "UFCS";
					subpmic_ufcs,name = "ufcs_port2";
					subpmic_ufcs,default-baudrate = <0x00>;
					subpmic_ufcs,default-request-volt = <0x1770>;
					subpmic_ufcs,default-request-curr = <0x7d0>;
				};

				subpmic_cid {
					compatible = "southchip,subpmic_cid";
					interrupts = <0x07>;
					interrupt-names = "CID";
					status = "okay";
				};
			};

			subpmic_core_nu@30 {
				compatible = "nuvolta,subpmic_core_nu";
				reg = <0x30>;
				status = "okay";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x04 0x00>;
				intr-gpio = <0xffffffff 0x04 0x00>;
				charger_name = "primary_chg";
				interrupt-controller;
				#interrupt-cells = <0x01>;

				chg {
					#io-channel-cells = <0x01>;
					status = "okay";
					compatible = "nuvolta,nu6601_charger";
					interrupts = <0x03 0x04 0x05 0x06 0x07 0x67 0x58 0x59 0x5a 0x5b 0x5c 0x5d 0x5e 0x5f 0x15 0x14 0x38 0x39 0x23 0x63 0x64>;
					interrupt-names = "usb_det_done", "vbus_0v", "vbus_gd", "chg_fsm", "chg_ok", "bc1p2_det_done", "dm_cot_pluse_done", "dp_cot_pluse_done", "dpdm_2pluse_done", "dpdm_3pluse_done", "dm_16pluse_done", "dp_16pluse_done", "hvdcp_det_fail", "hvdcp_det_ok", "boost_fail", "boost_gd", "led1_timeout", "led2_timeout", "vbat_ov", "dcd_timeout", "rid_cid_det";
					charger,enable-termination = <0x01>;
					charger,enable-ico = <0x00>;
					charger,batsns-en = <0x01>;
					charger,otg-vol = <0x1388>;
					charger,otg-current = <0x5dc>;
					charger,charge-voltage = <0x1130>;
