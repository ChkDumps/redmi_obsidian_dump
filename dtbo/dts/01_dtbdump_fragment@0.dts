			awinic_gpio_int {
				phandle = <0x4c>;

				pins_cmd0_dat {
					pinmux = <0x800>;
					bias-pull-up;
					input-enable;
				};
			};

			foursemi_gpio_reset {
				phandle = <0x4d>;

				pins_cmd0_dat {
					pinmux = <0x9a00>;
					bias-disable;
					output-low;
