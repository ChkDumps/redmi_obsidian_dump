					pinmux = <0x2d01>;
					drive-strength = <0x04>;
					input-enable;
					bias-disable;
				};
			};

			state_reset_high {
				phandle = <0x46>;

				pins_cmd_dat {
					pinmux = <0xd00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			state_reset_low {
				phandle = <0x47>;

				pins_cmd_dat {
					pinmux = <0xd00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			state_eint_default {
				phandle = <0x48>;

				pins_cmd_dat {
					pinmux = <0x00>;
					slew-rate = <0x00>;
					input-enable;
					bias-disable;
					input-schmitt-enable;
				};
			};

			state_eint_pulldown {
				phandle = <0x49>;

				pins_cmd_dat {
					pinmux = <0x00>;
					slew-rate = <0x00>;
					input-enable;
					bias-pull-down;
					input-schmitt-enable;
				};
			};
		};
	};

